# Environment variables for micro-journal

# Server Configuration (for CLI clients)
# Set this on your local machine to point CLI to remote VPS server
# Leave unset or use http://localhost:3000 for local development
MJ_SERVER_URL=http://localhost:3000
# Example for production: MJ_SERVER_URL=https://mj.noelr.ch

# Server Port (for server.js)
# PORT=3000

# Node Environment
# NODE_ENV=production
